<Project Sdk="Godot.NET.Sdk/4.5.1">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>true</ImplicitUsings>
    <LangVersion>13.0</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Aristocrat</RootNamespace>

    <!-- 改成你自己的杀戮尖塔2目录 -->
    <Sts2Dir>D:\Steam\steamapps\common\Slay the Spire 2</Sts2Dir>
    <Sts2DataDir>$(Sts2Dir)\data_sts2_windows_x86_64</Sts2DataDir>
    <GodotExe>D:\spire2mod tool\Godot_v4.5.1-stable_mono_win64\Godot_v4.5.1-stable_mono_win64.exe</GodotExe>
    <!-- 前置 mod BaseLib 的 dll。一份 dll 同时兼容正式版 / 测试版（见开发笔记「测试版分支」），
         所以这里一般不用改；要临时指向别处的 BaseLib 就 dotnet build -p:BaseLibDll="..." -->
    <BaseLibDll Condition="'$(BaseLibDll)' == ''">$(MSBuildProjectDirectory)\libs\BaseLib.dll</BaseLibDll>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="sts2">
      <HintPath>$(Sts2DataDir)\sts2.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="0Harmony">
      <HintPath>$(Sts2DataDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- 前置 mod：BaseLib（注册自定义关键词等） -->
    <Reference Include="BaseLib">
      <HintPath>$(BaseLibDll)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="Copy Mod" AfterTargets="PostBuildEvent">
    <Message Text="Copying mod to Slay the Spire 2 mods folder..." Importance="high" />
    <MakeDir Directories="$(Sts2Dir)\mods\$(MSBuildProjectName)\" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(Sts2Dir)\mods\$(MSBuildProjectName)\" />
    <Copy SourceFiles="$(MSBuildProjectName).json" DestinationFolder="$(Sts2Dir)\mods\$(MSBuildProjectName)\" />
  </Target>

  <Target Name="ExportPck">
    <Message Text="Exporting PCK..." Importance="high" />
    <Exec Command="&quot;$(GodotExe)&quot; --headless --path &quot;$(MSBuildProjectDirectory)&quot; --export-pack &quot;Windows Desktop&quot; &quot;$(Sts2Dir)\mods\$(MSBuildProjectName)\$(MSBuildProjectName).pck&quot;"
      EnvironmentVariables="IsInnerGodotExport=true;MSBUILDDISABLENODEREUSE=1"
      ContinueOnError="ErrorAndContinue" />
  </Target>
  <!-- 导出后清理资源包：去掉 Godot 硬塞的 project.binary / uid_cache.bin，否则会顶掉游戏的 UID 索引 -->
  <Target Name="CleanPck" AfterTargets="ExportPck">
    <Message Text="Cleaning PCK..." Importance="high" />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\tools\repack-pck.ps1&quot; -PckPath &quot;$(Sts2Dir)\mods\$(MSBuildProjectName)\$(MSBuildProjectName).pck&quot;"
      ContinueOnError="ErrorAndContinue" />
  </Target>
</Project>
